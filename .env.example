# Mothership — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Asana ────────────────────────────────────────────────────────
# Personal Access Token — https://app.asana.com/0/my-apps
ASANA_PAT=

# Workspace GID (numeric) — visible in any Asana URL
ASANA_WORKSPACE_ID=

# Project GIDs — grab from the project URL in Asana
ASANA_PROJECT_CCS=
ASANA_PROJECT_FORGE=
ASANA_PROJECT_ATHENA=
ASANA_PROJECT_NORTHCOAST=

# ── Shopify ───────────────────────────────────────────────────────
# Custom app Admin API token for Zebra Skimmers
SHOPIFY_ADMIN_TOKEN=

# ── Optional: Tailscale / Agent ──────────────────────────────────
# These are baked into the manifest but can be overridden here
# AGENT_BASE_URL=http://macbook.tail.ts.net

# ── AI Chat (Anthropic) ──────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com
# Used for the high-stakes chat endpoint at /api/chat
ANTHROPIC_API_KEY=

# ── Local LLM (Ollama) ───────────────────────────────────────────
# Self-hosted Ollama server on the iMac. Used for summaries, daily briefings,
# categorization — tasks where a small local model is fine.
# Defaults: http://10.0.0.45:11434 and model 'phi3'. Override if needed.
OLLAMA_BASE_URL=http://10.0.0.45:11434
OLLAMA_MODEL=phi3

# ── GitHub ────────────────────────────────────────────────────────
# Personal access token for commit feed (read:contents scope)
# Optional — public repos work without it, private repos require it
GITHUB_TOKEN=
